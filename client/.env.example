# Copy to .env.local and adjust. Only variables prefixed with VITE_ reach the browser.

# Base URL the future backend client will call. Keep it relative so the dev proxy handles it.
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api requests (the Node backend in ../server).
VITE_API_PROXY_TARGET=http://localhost:4000

# Show the TanStack Query devtools button in development.
VITE_QUERY_DEVTOOLS=false

# URL path the site is served under (the nginx location). Default /dev/laboratory/.
# Also names the deploy folder made by `npm run package` (dev-laboratory).
# BASE_PATH=/dev/laboratory/

# Emit source maps (not linked from the site) for debugging a production issue.
# SOURCEMAP=false
