# Copy to .env.local and adjust. Only variables prefixed with VITE_ reach the browser.

# Base URL the axios client uses for API calls. Keep it relative so the dev proxy handles it.
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api requests (the Node backend in ../server).
VITE_API_PROXY_TARGET=http://localhost:4000

# Show the TanStack Query devtools button in development.
VITE_QUERY_DEVTOOLS=false
