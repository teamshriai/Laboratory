# Copy to .env.local and adjust. Only variables prefixed with VITE_ reach the browser.

# Where the data comes from: mock (the in-browser demo, default) or http (the
# laboratory backend at VITE_API_BASE_URL). An http build carries no mock code.
# VITE_DATA_SOURCE=mock

# Base URL the backend client calls. Keep it relative so the dev proxy handles it.
VITE_API_BASE_URL=/api

# The backend's sign-in page (http mode), opened when the session has expired.
# VITE_LOGIN_URL=/login
# VITE_LOGOUT_URL=/logout

# Request timeout in milliseconds (http mode).
# VITE_REQUEST_TIMEOUT_MS=20000

# Where the Vite dev server forwards /api requests (the Node backend in ../server).
VITE_API_PROXY_TARGET=http://localhost:4000

# Show the TanStack Query devtools button in development.
VITE_QUERY_DEVTOOLS=false

# URL path the site is served under (the nginx location). Default /dev/laboratory/.
# Also names the deploy folder made by `npm run package` (dev-laboratory).
# BASE_PATH=/dev/laboratory/

# Emit source maps (not linked from the site) for debugging a production issue.
# SOURCEMAP=false
